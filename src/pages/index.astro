---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Image } from 'astro:assets';
import proxmoxCover from '../assets/books/proxmox-kubernetes.png';
import practiceCover from '../assets/books/kubernetes-practice.png';
import swarmCover from '../assets/books/docker-swarm.png';
import checkoutCover from '../assets/books/serverless-checkout.png';

const books = [
  {
    title: 'Proxmoxで始めるおうちKubernetes超入門',
    cover: proxmoxCover,
    description: 'おうちでKubernetesを始めるための超入門書。基礎から丁寧に解説します。',
    shopUrl: 'https://techbookfest.org/product/dRrkud2mGwsmUJs9JJp1g1',
    boothUrl: 'https://homecloud-lab.booth.pm/items/6531584',
    tags: ['Kubernetes', '入門', 'おうちクラウド']
  },
  {
    title: '実践！おうちKubernetes活用術',
    cover: practiceCover,
    description: 'Kubernetesをおうちで活用するための実践的なテクニックを紹介。',
    shopUrl: 'https://techbookfest.org/product/pwKksfKHgCd77VFRssPgK0',
    boothUrl: 'https://homecloud-lab.booth.pm/items/7050197',
    tags: ['Kubernetes', '実践', '運用']
  },
  {
    title: 'Docker Swarmで始めるお手軽コンテナ運用',
    cover: swarmCover,
    description: 'Docker Swarmのクラスター構築からサービス公開、ストレージ、GitOpsまでを紹介します。',
    shopUrl: 'https://techbookfest.org/product/tCWHr7CQQFWm7ZjTEXZrxH',
    tags: ['Docker Swarm', 'コンテナ', '運用']
  },
  {
    title: 'Cloudflareで作るサーバーレスセルフレジ開発記',
    cover: checkoutCover,
    description: '機材の調達から、Cloudflare Workers・D1・Square APIを使ったセルフレジの実装まで。イベントでの運用経験を交えて紹介します。',
    shopUrl: 'https://techbookfest.org/product/7X97gwedWvAgcLnjXtfiz',
    tags: ['Cloudflare', 'サーバーレス', 'セルフレジ']
  }
];

const booksStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": books.map((book, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Book",
      "name": book.title,
      "description": book.description,
      "image": new URL(book.cover.src, Astro.site).href,
      "author": {
        "@type": "Organization",
        "name": "おうちクラウド研究部"
      },
      "url": book.shopUrl
    }
  }))
};

const activities = [
  { year: '2026', name: '技書博14', url: 'https://gishohaku.dev/gishohaku14/circles/NZaUq1xydiFlcyI9rym9' },
  { year: '2026', name: '技術書典20', url: 'https://techbookfest.org/product/7X97gwedWvAgcLnjXtfiz' },
  { year: '2025', name: '技術書典19', url: 'https://techbookfest.org/product/tCWHr7CQQFWm7ZjTEXZrxH' },
  { year: '2025', name: '技書博12', url: 'https://gishohaku.dev/gishohaku12/circles' },
  { year: '2025', name: '技術書典18', url: 'https://techbookfest.org/product/pwKksfKHgCd77VFRssPgK0' },
  { year: '2025', name: '技書博11', url: 'https://gishohaku.dev/gishohaku11' },
  { year: '2024', name: '技術書典17', url: 'https://techbookfest.org/product/dRrkud2mGwsmUJs9JJp1g1' },
];
---

<Layout title="おうちクラウド研究部">
  <SiteHeader />
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div>
        <p class="hero-intro">自宅サーバーから、広がる楽しみ。</p>
        <h1 id="hero-title">おうちでつくる。<br />クラウドであそぶ。</h1>
      </div>
      <div class="hero-about">
        <p>手元のマシンから、Kubernetesのある暮らしへ。<br class="desktop-break" />自分で試して、動かして、わかったことを本にしています。</p>
        <a class="text-link" href="#books">出版物を見る <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section id="books" class="books" aria-labelledby="books-title">
      <div class="container">
        <div class="section-heading">
          <h2 id="books-title">これまでの出版物</h2>
          <p>構築の第一歩から、日々の運用まで。</p>
        </div>
        <div class="book-grid">
          {books.map((book) => (
            <article class="book">
              <a href={book.shopUrl} target="_blank" rel="noopener noreferrer" class="book-cover-link" aria-label={`${book.title}を技術書典で見る（別タブ）`}>
                <Image src={book.cover} alt={`${book.title}の表紙`} widths={[320, 640, 960]} sizes="(max-width: 600px) 260px, (max-width: 900px) 280px, 220px" width={640} format="webp" loading="eager" class="book-cover" />
              </a>
              <div class="book-content">
                <p class="book-topics">{book.tags.join(' / ')}</p>
                <h3>{book.title}</h3>
                <p class="book-description">{book.description}</p>
                <div class="book-links">
                  <a class="book-link" href={book.shopUrl} target="_blank" rel="noopener noreferrer">技術書典で見る <span aria-hidden="true">↗</span></a>
                  {book.boothUrl && (
                    <a class="book-link" href={book.boothUrl} target="_blank" rel="noopener noreferrer">BOOTHで見る <span aria-hidden="true">↗</span></a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="shop-note">
          <p>ほかの出版物・販売状況は、各ショップでご覧いただけます。</p>
          <div>
            <a class="text-link" href="https://techbookfest.org/organization/7ZKV9gyQ1aSZn92Jb8XA5K" target="_blank" rel="noopener noreferrer">技術書典 <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://homecloud-lab.booth.pm/" target="_blank" rel="noopener noreferrer">BOOTH <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="about container" aria-labelledby="about-title">
      <div class="about-heading">
        <img src="/logo.png" alt="" width="88" height="88" loading="lazy" />
        <h2 id="about-title">おうちクラウド研究部<br />について</h2>
      </div>
      <div class="about-copy">
        <p>自宅でKubernetesやクラウド技術を楽しむ、技術同人サークルです。</p>
        <p>サーバーを選ぶ。ネットワークをつなぐ。サービスを動かす。そんな実践の中で得た知識を、初心者から中級者向けの技術書として届けています。</p>
      </div>
    </section>

    <section id="activities" class="activities container" aria-labelledby="activities-title">
      <div class="section-intro">
        <h2 id="activities-title">活動歴</h2>
        <p>技術書典や技書博で、<br />本を通じて交流しています。</p>
      </div>
      <ol class="activity-list">
        {activities.map((activity) => (
          <li>
            <span class="activity-year">{activity.year}</span>
            <a href={activity.url} target="_blank" rel="noopener noreferrer">{activity.name}<span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ol>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <div>
          <h2 id="contact-title">お問い合わせ</h2>
          <p>書籍やサークルについてのご質問はこちらへ。</p>
        </div>
        <a href="mailto:admin@k1h.dev">admin@k1h.dev <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(booksStructuredData)} />
  </main>
  <SiteFooter />
</Layout>

<style>
  .hero { padding-block: 76px 64px; display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: end; }
  .hero-intro { font-size: .9rem; font-weight: 600; margin-bottom: 22px; color: var(--muted); }
  h1 { font-size: clamp(2.5rem, 4.6vw, 4rem); line-height: 1.4; letter-spacing: -.045em; }
  .hero-about { padding-bottom: 8px; }
  .hero-about p { line-height: 2; font-size: .95rem; margin-bottom: 22px; }
  .hero-about .text-link { font-size: .9rem; }
  .books { padding: 46px 0 36px; background: var(--wash); border-radius: 36px 36px 0 0; }
  .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; margin-bottom: 38px; }
  h2 { font-size: 1.65rem; letter-spacing: -.025em; }
  .section-heading p { font-size: .9rem; color: var(--muted); }
  .book-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .book { min-width: 0; display: flex; flex-direction: column; }
  .book-cover-link { height: 341px; flex-shrink: 0; display: flex; justify-content: center; align-items: end; padding: 0 18px 24px; border-bottom: 5px solid #c6d7e1; }
  .book-cover { width: 100%; max-width: 280px; height: auto; max-height: 312px; object-fit: contain; box-shadow: 4px 6px 0 #153d5812, 8px 12px 20px #153d5818; transition: transform .2s ease; }
  .book-cover-link:hover .book-cover { transform: translateY(-6px); }
  .book-content { padding-top: 24px; display: flex; flex-direction: column; align-items: flex-start; flex: 1; }
  .book-topics { font-size: .72rem; color: var(--muted); margin-bottom: 10px; }
  .book h3 { font-size: 1.24rem; line-height: 1.65; letter-spacing: -.02em; margin-bottom: 12px; }
  .book-description { font-size: .875rem; line-height: 1.9; color: var(--muted); margin-bottom: 22px; }
  .book-links { display: grid; gap: 10px; width: 100%; margin-top: auto; }
  .book-link { display: flex; justify-content: space-between; gap: 32px; width: 100%; padding: 12px 16px; border: 1px solid #afc7d7; border-radius: 6px; font-size: .85rem; font-weight: 600; background: #ffffff80; }
  .book-link:hover { background: var(--ink); color: white; border-color: var(--ink); }
  .shop-note { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; padding-top: 34px; margin-top: 34px; border-top: 1px solid #d0dee7; font-size: .8rem; color: var(--muted); }
  .shop-note > div { display: flex; gap: 28px; }
  .about { display: grid; grid-template-columns: 1fr 1.3fr; gap: 70px; padding-block: 80px; }
  .about-heading { display: flex; gap: 24px; align-items: center; }
  .about-heading img { border-radius: 50%; }
  .about h2 { font-size: 1.4rem; line-height: 1.65; }
  .about-copy { font-size: .95rem; line-height: 2; }
  .about-copy p + p { margin-top: 14px; color: var(--muted); }
  .activities { display: grid; grid-template-columns: 1fr 1.3fr; gap: 70px; padding-block: 20px 90px; }
  .section-intro p { margin-top: 20px; color: var(--muted); font-size: .9rem; line-height: 1.9; }
  .activity-list { list-style: none; }
  .activity-list li { display: flex; gap: 36px; padding: 19px 0; border-bottom: 1px solid var(--line); }
  .activity-list li:first-child { border-top: 1px solid var(--line); }
  .activity-year { font-size: .85rem; color: var(--muted); font-variant-numeric: tabular-nums; padding-top: 3px; }
  .activity-list a { display: flex; justify-content: space-between; flex: 1; font-weight: 600; }
  .activity-list a span { color: var(--muted); }
  .contact { background: var(--ink); color: white; padding-block: 44px; }
  .contact-inner { display: flex; align-items: center; justify-content: space-between; gap: 30px; }
  .contact h2 { font-size: 1.35rem; margin-bottom: 12px; }
  .contact p { font-size: .85rem; color: #c9dce9; }
  .contact a { color: white; font-size: clamp(1.3rem, 3vw, 2rem); font-weight: 600; }
  .contact a span { margin-left: 24px; }
  @media (max-width: 900px) {
    .hero { gap: 30px; grid-template-columns: 1fr; padding-block: 48px; }
    .hero-about { max-width: 560px; }
    .desktop-break { display: none; }
    .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 28px; }
    .book-cover { max-height: 398px; }
    .book-cover-link { height: 427px; padding-inline: 6px; }
    .book h3 { font-size: 1.05rem; }
    .about, .activities { gap: 32px; }
    .about-heading { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 600px) {
    .hero { gap: 22px; padding-block: 36px 40px; }
    h1 { font-size: clamp(2rem, 8.6vw, 3rem); }
    .hero-intro { font-size: .8rem; margin-bottom: 16px; }
    .hero-about p { font-size: .875rem; }
    .books { border-radius: 24px 24px 0 0; padding-top: 30px; }
    .section-heading { display: block; margin-bottom: 30px; }
    .section-heading p { margin-top: 10px; }
    .book-grid { grid-template-columns: 1fr; gap: 42px; }
    .book { max-width: 380px; margin-inline: auto; width: 100%; }
    .book-cover { max-width: 260px; max-height: 369px; }
    .book-cover-link { height: 398px; padding-bottom: 22px; }
    .book-content { padding-top: 20px; }
    .book h3 { font-size: 1.2rem; }
    .shop-note { align-items: flex-start; }
    .about, .activities { grid-template-columns: 1fr; gap: 28px; padding-block: 44px; }
    .about-heading { flex-direction: row; gap: 18px; }
    .about-heading img { width: 64px; height: 64px; }
    .about h2 { font-size: 1.25rem; }
    .activities { padding-top: 12px; }
    .section-intro p br { display: none; }
    .section-intro p { margin-top: 12px; }
    .contact-inner { align-items: flex-start; flex-direction: column; gap: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .book-cover { transition: none; } .book-cover-link:hover .book-cover { transform: none; } }
</style>
