---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="ページが見つかりません" noindex>
  <SiteHeader />
  <main id="main" class="container not-found">
    <p class="status">404</p>
    <h1>ページが見つかりません</h1>
    <p>URLが変更されたか、ページが存在しない可能性があります。</p>
    <a class="text-link" href="/">ホームに戻る</a>
  </main>
  <SiteFooter />
</Layout>

<style>
  .not-found { padding-block: 80px 120px; min-height: 65vh; }
  .status { color: var(--muted); font-size: 1.2rem; letter-spacing: .12em; }
  h1 { margin-block: 16px 24px; font-size: clamp(1.6rem, 4vw, 2.5rem); }
  .text-link { display: inline-block; margin-top: 32px; }
</style>
