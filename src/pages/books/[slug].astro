---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { books } from '../../data/books';

export function getStaticPaths() {
  return books.map(book => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props;
const bookURL = new URL(`/books/${book.slug}/`, Astro.site).href;
const description = `${book.title}。${book.description} 著者VOID、おうちクラウド研究部。内容紹介と購入先をご案内します。`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Book',
      '@id': `${bookURL}#book`,
      name: book.title,
      description: book.description,
      url: bookURL,
      image: new URL(book.cover.src, Astro.site).href,
      inLanguage: 'ja',
      author: { '@type': 'Person', name: 'VOID' },
      publisher: { '@id': new URL('/#organization', Astro.site).href },
      sameAs: [book.shopUrl, ...(book.boothUrl ? [book.boothUrl] : [])],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: Astro.site!.href },
        { '@type': 'ListItem', position: 2, name: book.title, item: bookURL },
      ],
    },
  ],
};
---

<Layout title={book.title} description={description} ogImage={book.cover.src}
  ogImageAlt={`${book.title}の表紙`} ogImageWidth={book.cover.width} ogImageHeight={book.cover.height}
  mainEntityId={`${bookURL}#book`}>
  <SiteHeader />
  <main id="main" class="container book-page">
    <nav class="breadcrumbs" aria-label="パンくずリスト">
      <a href="/">ホーム</a><span aria-hidden="true">/</span><span aria-current="page">{book.title}</span>
    </nav>
    <article class="book-detail">
      <div class="cover">
        <Image src={book.cover} alt={`${book.title}の表紙`} width={640}
          widths={[320, 640, 960]} sizes="(max-width: 600px) 260px, 340px" format="webp" loading="eager" fetchpriority="high" />
      </div>
      <div class="content">
        <p class="topics">{book.tags.join(' / ')}</p>
        <h1>{book.title}</h1>
        <p class="author">VOID 著 ／ おうちクラウド研究部</p>
        <p class="description">{book.description}</p>
        <section aria-labelledby="contents-heading">
          <h2 id="contents-heading">この本で扱うこと</h2>
          <ul>{book.chapters.map(chapter => <li>{chapter}</li>)}</ul>
        </section>
        <section class="purchase" aria-labelledby="purchase-heading">
          <h2 id="purchase-heading">購入先</h2>
          <p>価格・販売形式・在庫は各販売ページでご確認ください。</p>
          <div class="purchase-links">
            <a href={book.shopUrl} target="_blank" rel="noopener noreferrer">技術書典で見る <span aria-hidden="true">↗</span></a>
            {book.boothUrl && <a href={book.boothUrl} target="_blank" rel="noopener noreferrer">BOOTHで見る <span aria-hidden="true">↗</span></a>}
          </div>
        </section>
      </div>
    </article>
    <section class="other-books" aria-labelledby="other-books-heading">
      <h2 id="other-books-heading">ほかの出版物</h2>
      <ul>{books.filter(other => other.slug !== book.slug).map(other => (
        <li><a href={`/books/${other.slug}/`}>{other.title}</a></li>
      ))}</ul>
      <a class="text-link" href="/#books">出版物一覧に戻る</a>
    </section>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\u003c')} />
  </main>
  <SiteFooter />
</Layout>

<style>
  .book-page { padding-block: 24px 64px; }
  .breadcrumbs { display: flex; gap: 12px; flex-wrap: wrap; font-size: .8rem; color: var(--muted); margin-bottom: 40px; }
  .breadcrumbs a { text-decoration: underline; }
  .book-detail { display: grid; grid-template-columns: minmax(240px, 340px) minmax(0, 1fr); gap: 64px; align-items: start; }
  .cover { background: var(--wash); padding: 24px; border-radius: 12px; }
  .cover img { width: 100%; height: auto; display: block; box-shadow: 4px 8px 16px #173f5920; }
  .topics, .author { color: var(--muted); font-size: .85rem; }
  h1 { font-size: clamp(1.65rem, 3vw, 2.5rem); line-height: 1.5; margin: 12px 0 18px; }
  .description { margin: 24px 0 32px; line-height: 1.9; }
  h2 { font-size: 1.2rem; margin-bottom: 16px; }
  ul { padding-left: 1.25rem; }
  li { margin-bottom: 12px; line-height: 1.8; }
  .purchase { margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--line); }
  .purchase p { font-size: .85rem; color: var(--muted); }
  .purchase-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .purchase-links a { padding: 12px 20px; border: 1px solid var(--ink); border-radius: 6px; font-size: .9rem; font-weight: 600; }
  .purchase-links span { margin-left: 20px; }
  .other-books { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); }
  .other-books ul { margin-bottom: 24px; }
  .other-books li a { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) { .book-detail { grid-template-columns: minmax(200px, 280px) minmax(0, 1fr); gap: 32px; } }
  @media (max-width: 600px) {
    .book-detail { grid-template-columns: 1fr; gap: 28px; }
    .cover { width: min(100%, 308px); margin-inline: auto; }
    .breadcrumbs { margin-bottom: 28px; }
  }
</style>
